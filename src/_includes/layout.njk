<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description }}">
    <meta name="generator" content="{{ eleventy.generator }}">
    <link rel="canonical" href="https://m0jxd.github.io/"/>
    <link rel="stylesheet" href="/bundle.css">
    <title>{{ title }}</title>
    <link rel="icon" type="image/x-icon" href="/img/pfp.jpg">
</head>
<body>
    <header>
        <a href="/"><img src="/img/pfp.jpg" alt="Jamie's Usual PFP"></a>
        <h1>M0JXD's Website</h1>
        <nav>
        <a href="/sitemap">Sitemap</a>
        </nav>
    </header>
    <main>
        <article>
        {{ content | safe }}
        </article>
        <p><em>
        <br>
        Page created: {{ created }}
        <br>
        Last modified: {{ page.date | datefilter }}
        </em><p>
    </main>
    <footer>
        <div class="fill"></div>
        <div class="copyright"><p>Copyright © 2025&hyphen;2026 Jamie Drinkell</p></div>
        <div class="social-links">
        <a href="https://github.com/M0JXD" target="_blank"><img src="/img/github.png" alt="GitHub"></a>
        <a href="https://www.instagram.com/jamiedrinkell" target="_blank"><img src="/img/instagram.png" alt="Instagram"></a>
        <a href="https://www.youtube.com/@jamiedrinkell" target="_blank"><img src="/img/youtube.png" alt="YouTube"></a>
        </div>
    </footer>
</body>
</html>
